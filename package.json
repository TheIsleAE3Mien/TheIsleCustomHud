{
  "name": "the-isle-custom-hud",
  "private": true,
  "version": "0.3.1",
  "description": "Customizable Windows in-game HUD for The Isle",
  "author": "TheIsleAE3Mien",
  "contributors": [
    {
      "name": "YannikAufDie1",
      "url": "https://github.com/reversum/isle-overlay"
    }
  ],
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit --pretty false && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && npx electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "electron-updater": "^6.6.2",
    "koffi": "^3.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.theisleae3mien.customhud",
    "productName": "TheIsleCustomHud",
    "protocols": [
      {
        "name": "IsleOverlay",
        "schemes": [
          "isle-overlay"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*.json"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "publisherName": "TheIsleAE3Mien",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "TheIsleCustomHud-${version}-Setup.exe"
    },
    "copyright": "Copyright © 2026 TheIsleAE3Mien; based on isle-overlay by YannikAufDie1",
    "publish": [
      {
        "provider": "github",
        "owner": "TheIsleAE3Mien",
        "repo": "TheIsleCustomHud",
        "releaseType": "release"
      }
    ]
  }
}
